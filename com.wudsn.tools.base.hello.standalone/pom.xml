<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.wudsn.tools</groupId>
		<artifactId>wudsn-base-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<artifactId>com.wudsn.tools.base.hello.standalone</artifactId>
	<packaging>jar</packaging>

	<name>WUDSN Tools Base Hello Standalone</name>

	<properties>
		<swt.artifactId>org.eclipse.swt.win32.win32.x86_64</swt.artifactId>
		<swt.systemPath>${project.basedir}/../com.wudsn.tools.base.standalone/lib/win32-x86_64/swt.jar</swt.systemPath>
	</properties>

	<profiles>
		<profile>
			<id>swt-windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<swt.artifactId>org.eclipse.swt.win32.win32.x86_64</swt.artifactId>
				<swt.systemPath>${project.basedir}/../com.wudsn.tools.base.standalone/lib/win32-x86_64/swt.jar</swt.systemPath>
			</properties>
		</profile>
		<profile>
			<id>swt-linux</id>
			<activation>
				<os>
					<family>unix</family>
					<name>linux</name>
				</os>
			</activation>
			<properties>
				<swt.artifactId>org.eclipse.swt.gtk.linux.x86_64</swt.artifactId>
				<swt.systemPath>${project.basedir}/../com.wudsn.tools.base.standalone/lib/linux-x86_64/swt.jar</swt.systemPath>
			</properties>
		</profile>
		<profile>
			<id>swt-macos-x86_64</id>
			<activation>
				<os>
					<family>mac</family>
					<arch>x86_64</arch>
				</os>
			</activation>
			<properties>
				<swt.artifactId>org.eclipse.swt.cocoa.macosx.x86_64</swt.artifactId>
				<swt.systemPath>${project.basedir}/../com.wudsn.tools.base.standalone/lib/macos-x86_64/swt.jar</swt.systemPath>
			</properties>
		</profile>
		<profile>
			<id>swt-macos-aarch64</id>
			<activation>
				<os>
					<family>mac</family>
					<arch>aarch64</arch>
				</os>
			</activation>
			<properties>
				<swt.artifactId>org.eclipse.swt.cocoa.macosx.aarch64</swt.artifactId>
				<swt.systemPath>${project.basedir}/../com.wudsn.tools.base.standalone/lib/macos-aarch64/swt.jar</swt.systemPath>
			</properties>
		</profile>
	</profiles>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>${swt.artifactId}</artifactId>
			<version>local</version>
			<scope>system</scope>
			<systemPath>${swt.systemPath}</systemPath>
		</dependency>
		<dependency>
			<groupId>org.eclipse.equinox</groupId>
			<artifactId>org.eclipse.equinox.common</artifactId>
			<version>local</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/lib/org.eclipse.equinox.common.jar</systemPath>
		</dependency>
		<dependency>
			<groupId>org.eclipse</groupId>
			<artifactId>org.eclipse.osgi</artifactId>
			<version>local</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/lib/org.eclipse.osgi.jar</systemPath>
		</dependency>
	</dependencies>

	<build>
		<finalName>Hello</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>com.wudsn.tools.base.hello.Hello</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
